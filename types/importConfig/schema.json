{
  "$id": "https://github.com/data-fair/catalog-data-fair/import-config",
  "x-exports": [
    "types",
    "validate",
    "schema"
  ],
  "title": "Import configuration",
  "x-i18n-title": {
    "fr": "Configuration de l'import"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fields": {
      "type": "array",
      "default": [],
      "title": "Dataset columns",
      "x-i18n-title": {
        "fr": "Colonnes du jeu de données"
      },
      "description": "The list of columns to import. If this field is empty, all columns will be imported.",
      "x-i18n-description": {
        "fr": "La liste des colonnes à importer. Si ce champ est vide, toutes les colonnes seront importées."
      },
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "layout": {
        "density": "compact",
        "getItems": {
          "url": "${context.catalogConfig.url}/data-fair/api/v1/datasets/${context.resourceId}/schema?calculated=false",
          "itemTitle": "item.label",
          "itemKey": "item.key"
        }
      }
    },
    "filters": {
      "$ref": "#/$defs/filters"
    }
  },
  "$defs": {
    "filters": {
      "title": "Predefined filters",
      "x-i18n-title": {
        "fr": "Filtres prédéfinis"
      },
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "default": {
          "type": "in"
        },
        "required": [
          "type"
        ],
        "oneOf": [
          {
            "title": "Restrict to specific values",
            "x-i18n-title": {
              "fr": "Restreindre à des valeurs précises"
            },
            "required": [
              "field",
              "values",
              "type"
            ],
            "properties": {
              "type": {
                "const": "in"
              },
              "field": {
                "$ref": "#/$defs/filterField"
              },
              "values": {
                "type": "array",
                "title": "Values",
                "x-i18n-title": {
                  "fr": "Valeurs"
                },
                "description": "Imports only rows where the value of the indicated field is equal to one of the entered values.<br>*Not all values may be displayed, type to search for a specific field.*",
                "x-i18n-description": {
                  "fr": "Importe seulement des lignes où la valeur du champ indiqué est égale à l'une des valeurs renseignées.<br>*Toutes les valeurs peuvent ne pas être affichées, écrivez pour rechercher un champ particulier.*"
                },
                "items": {
                  "type": "string"
                },
                "layout": {
                  "getItems": {
                    "url": "${context.catalogConfig.url}/data-fair/api/v1/datasets/${context.resourceId}/values/${parent.data.field.key}?q={q}&q_mode=complete&size=100&stringify=true"
                  },
                  "props": {
                    "clearable": true
                  }
                },
                "default": []
              }
            }
          },
          {
            "title": "Exclude values",
            "x-i18n-title": {
              "fr": "Exclure des valeurs"
            },
            "required": [
              "field",
              "values",
              "type"
            ],
            "properties": {
              "type": {
                "const": "nin"
              },
              "field": {
                "$ref": "#/$defs/filterField"
              },
              "values": {
                "type": "array",
                "title": "Values to exclude",
                "x-i18n-title": {
                  "fr": "Valeurs à exclure"
                },
                "description": "Imports only rows where the value of the indicated field differs from the entered values.<br>*Not all values may be displayed, type to search for a specific field.*",
                "x-i18n-description": {
                  "fr": "Importe seulement des lignes où la valeur du champ indiqué est différente des valeurs renseignées.<br>*Toutes les valeurs peuvent ne pas être affichées, écrivez pour rechercher un champ particulier.*"
                },
                "items": {
                  "type": "string"
                },
                "layout": {
                  "getItems": {
                    "url": "${context.catalogConfig.url}/data-fair/api/v1/datasets/${context.resourceId}/values/${parent.data.field.key}?q={q}&q_mode=complete&size=100&stringify=true"
                  },
                  "props": {
                    "clearable": true
                  }
                },
                "default": []
              }
            }
          },
          {
            "title": "Greater than a value",
            "x-i18n-title": {
              "fr": "Supérieur à une valeur"
            },
            "required": [
              "field",
              "value",
              "type"
            ],
            "properties": {
              "type": {
                "const": "gte"
              },
              "field": {
                "$ref": "#/$defs/filterField"
              },
              "value": {
                "type": "string",
                "title": "Minimum value",
                "x-i18n-title": {
                  "fr": "Valeur minimale"
                },
                "description": "Imports only rows where the value of the indicated field is greater than or equal to the entered value. The value can be a number, a string (*alphanumeric order*), or a date.<br>*Not all values may be displayed, type to search for a specific field.*",
                "x-i18n-description": {
                  "fr": "Importe seulement des lignes où la valeur du champ indiqué est supérieur ou égale à la valeur renseignée. La valeur peut être un nombre, une chaîne de caractère (*ordre alphanumérique*), une date.<br>*Toutes les valeurs peuvent ne pas être affichées, écrivez pour rechercher un champ particulier.*"
                },
                "layout": {
                  "comp": "combobox",
                  "getItems": {
                    "url": "${context.catalogConfig.url}/data-fair/api/v1/datasets/${context.resourceId}/values/${parent.data.field.key}?q={q}&q_mode=complete&size=100&stringify=true&sort=asc"
                  }
                }
              }
            }
          },
          {
            "title": "Less than a value",
            "x-i18n-title": {
              "fr": "Inférieur à une valeur"
            },
            "required": [
              "field",
              "value",
              "type"
            ],
            "properties": {
              "type": {
                "const": "lte"
              },
              "field": {
                "$ref": "#/$defs/filterField"
              },
              "value": {
                "type": "string",
                "title": "Maximum value",
                "x-i18n-title": {
                  "fr": "Valeur maximale"
                },
                "description": "Imports only rows where the value of the indicated field is lower than the entered value. The value can be a number, a string (*alphanumeric order*), or a date.<br>*Not all values may be displayed, type to search for a specific field.*",
                "x-i18n-description": {
                  "fr": "Importe seulement les lignes où la valeur du champ indiqué est inférieur à la valeur renseignée. La valeur peut être un nombre, une chaîne de caractère (*ordre alphanumérique*), une date.<br>*Toutes les valeurs peuvent ne pas être affichées, écrivez pour rechercher un champ particulier.*"
                },
                "layout": {
                  "comp": "combobox",
                  "getItems": {
                    "url": "${context.catalogConfig.url}/data-fair/api/v1/datasets/${context.resourceId}/values/${parent.data.field.key}?q={q}&q_mode=complete&size=100&stringify=true&sort=asc"
                  }
                }
              }
            }
          },
          {
            "title": "Starts with characters",
            "x-i18n-title": {
              "fr": "Commence par les caractères"
            },
            "required": [
              "field",
              "value",
              "type"
            ],
            "properties": {
              "type": {
                "const": "starts"
              },
              "field": {
                "$ref": "#/$defs/filterFieldString"
              },
              "value": {
                "type": "string",
                "description": "Imports only rows where the indicated field (column) starts with a specific string. The string is case-sensitive.<br>Only fields (columns) whose values are strings are accepted.<br>*Not all values may be displayed, type to search for a specific field.*",
                "x-i18n-description": {
                  "fr": "Importe seulement les lignes où le champ (colonne) indiqué commence par une chaîne de caractères précise. La chaîne de caractères est sensible à la casse.<br>Seuls les champs (colonnes) ayant pour valeurs des chaînes de caractères sont acceptées.<br>*Toutes les valeurs peuvent ne pas être affichées, écrivez pour rechercher un champ particulier.*"
                },
                "title": "Starts with characters",
                "x-i18n-title": {
                  "fr": "Commence par les caractères"
                },
                "layout": {
                  "comp": "combobox",
                  "getItems": {
                    "url": "${context.catalogConfig.url}/data-fair/api/v1/datasets/${context.resourceId}/values/${parent.data.field.key}?q={q}&q_mode=complete&size=100&stringify=true"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "filterField": {
      "type": "object",
      "title": "Filter column",
      "x-i18n-title": {
        "fr": "Colonne de filtre"
      },
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "layout": {
        "getItems": {
          "url": "${context.catalogConfig.url}/data-fair/api/v1/datasets/${context.resourceId}/schema?calculated=false",
          "itemTitle": "item.label",
          "itemKey": "item.key"
        }
      }
    },
    "filterFieldString": {
      "type": "object",
      "title": "Filter column",
      "x-i18n-title": {
        "fr": "Colonne de filtre"
      },
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "layout": {
        "getItems": {
          "url": "${context.catalogConfig.url}/data-fair/api/v1/datasets/${context.resourceId}/schema?calculated=false&type=string",
          "itemTitle": "item.label",
          "itemKey": "item.key"
        }
      }
    }
  }
}